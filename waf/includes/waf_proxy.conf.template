# En-têtes transmis en aval. X-Forwarded-For est REMPLACÉ par l'IP vue par le WAF (jamais complété) :
# une valeur envoyée par le client ne peut pas usurper une autre IP auprès de la passerelle.
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $http_host;              # avec le port : contrôle d'origine des Server Actions Next.js
proxy_set_header X-Forwarded-Host $http_host;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Request-ID $request_id;
proxy_connect_timeout 2s;
proxy_send_timeout 15s;
proxy_read_timeout 15s;
