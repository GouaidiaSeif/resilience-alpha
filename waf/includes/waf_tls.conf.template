# TLS : certificat autosigné généré par l'image au démarrage (laboratoire). Pour un vrai certificat, monter
# waf/certs/server.crt et server.key et définir SSL_CERT_FILE / SSL_CERT_KEY_FILE dans docker-compose.yml.
ssl_certificate ${SSL_CERT_FILE};
ssl_certificate_key ${SSL_CERT_KEY_FILE};
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:WafTLS:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
