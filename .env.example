# Modèle de configuration. Ne contient AUCUN secret réel.
# Générer le vrai .env :  python scripts/gen_env.py   (le .env est ignoré par Git)
# Cible : migrer ces valeurs vers Vault ou SOPS.
JWT_SECRET=CHANGE_ME
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
ACCOUNTS_DB_PASSWORD=CHANGE_ME
PAYMENTS_DB_PASSWORD=CHANGE_ME
NOTIFICATIONS_DB_PASSWORD=CHANGE_ME
AUDIT_DB_PASSWORD=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
CANARY_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

LOG_LEVEL=INFO
PAYMENT_MAX_AMOUNT=5000
CANARY_ALERTS_ENABLED=true

# Alertes Grafana livrées sur Discord (salon > Intégrations > Webhooks). Vide = alertes dans Grafana seulement.
DISCORD_WEBHOOK_URL=
# Fuseau des heures affichées dans les messages d'alerte.
TZ=Europe/Paris

# WAF : IP réelle des clients sous Docker Desktop (Windows/macOS) grâce au relais de l'hôte (scripts/edge_relay.py,
# lancé par scripts/start.ps1). Le WAF libère alors 8080/8443 pour le relais. Sous Linux : EDGE_RELAY=false et
# supprimer les deux lignes WAF_*_BIND (le WAF publie directement 8080/8443, l'IP y est déjà réelle).
EDGE_RELAY=true
WAF_HTTP_BIND=127.0.0.1:28080
WAF_HTTPS_BIND=127.0.0.1:28443
# Moteur du WAF : On (bloque) ou DetectionOnly (journalise seulement, pour valider de nouvelles règles).
WAF_RULE_ENGINE=On
