    {
      "type": "timeseries",
      "id": 2,
      "title": "Lignes de log par minute, par niveau",
      "description": "Services Python (JSON). Les conteneurs non Python (Postgres, Grafana…) n'ont pas de niveau et n'y figurent pas.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (level) (count_over_time({service=~\"$service\", level=~\".+\"} [1m]))",
          "queryType": "range",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "custom": {
            "drawStyle": "line",
