    {
      "type": "table",
      "id": 6,
      "title": "Échecs de connexion par IP et identifiant (période)",
      "description": "Top 10. Les connexions passées par le front portent toutes l'adresse de son conteneur (10.250.0.10).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(10, sum by (client_ip, username) (count_over_time({service=\"auth\"} | json | event=~\"login_failed|login_blocked\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "client_ip": "IP source",
              "username": "Identifiant",
              "Value #A": "Échecs",
              "Value": "Échecs"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "—"
