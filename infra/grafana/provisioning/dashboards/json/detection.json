      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(detector_max_attack_probability)",
          "legendFormat": "Probabilité",
          "range": true,
          "instant": false
