    {
      "type": "table",
      "id": 12,
      "title": "Adresses les plus bloquées par ModSecurity (période)",
      "description": "IP réelle du client (relais d'IP réelle actif) ; 10.250.0.1 = tous les clients extérieurs sans relais.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(10, sum by (client_ip) (count_over_time({service=\"waf\"} |= `\"transaction\"` | json client_ip=\"transaction.client_ip\", interrupted=\"transaction.is_interrupted\" | interrupted=\"true\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "client_ip": "Adresse IP",
              "Value #A": "Requêtes bloquées",
              "Value": "Requêtes bloquées"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Requêtes bloquées",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "table",
      "id": 13,
      "title": "Règles qui ont bloqué (période)",
