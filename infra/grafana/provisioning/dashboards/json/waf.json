    {
      "type": "timeseries",
      "id": 9,
      "title": "Réponses du WAF par minute, par issue",
      "description": "Journal d'accès du WAF : réponses normales, refus 403 (ModSecurity, bans, ML), limite de débit 429, autres erreurs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service=\"waf\"} |= `\"source\":\"waf\"` | json | __error__=\"\" | status < 400 [1m]))",
          "queryType": "range",
          "legendFormat": "2xx/3xx"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "B",
          "expr": "sum(count_over_time({service=\"waf\"} |= `\"source\":\"waf\"` | json | __error__=\"\" | status = 403 [1m]))",
          "queryType": "range",
          "legendFormat": "403"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "C",
          "expr": "sum(count_over_time({service=\"waf\"} |= `\"source\":\"waf\"` | json | __error__=\"\" | status = 429 [1m]))",
          "queryType": "range",
          "legendFormat": "429"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "D",
          "expr": "sum(count_over_time({service=\"waf\"} |= `\"source\":\"waf\"` | json | __error__=\"\" | status >= 400 | status != 403 | status != 429 [1m]))",
          "queryType": "range",
          "legendFormat": "Autres 4xx/5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Aucune donnée sur la période"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx/3xx"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "2xx/3xx"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "403"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Refusées (403)"
              },
              {
                "id": "color",
