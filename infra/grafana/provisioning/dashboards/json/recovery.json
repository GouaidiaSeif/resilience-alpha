{
  "uid": "ra-recovery",
  "title": "Resilience Alpha · Reprise autonome",
  "description": "Avant / pendant / après un incident : disponibilité, preuve de reprise, remédiation. Annotations : alertes de la sonde, remédiations lancées, reprises prouvées.",
  "tags": [
    "resilience-alpha",
    "reprise",
    "jury"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Reprise autonome",
      "type": "link",
      "url": "/d/ra-recovery",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "title": "Trafic et paiements",
      "type": "link",
      "url": "/d/ra-traffic",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "title": "Journaux et sécurité",
      "type": "link",
      "url": "/d/ra-logs",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "title": "Détection ML",
      "type": "link",
      "url": "/d/ra-detection",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "title": "WAF et bans",
      "type": "link",
      "url": "/d/ra-waf",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "title": "Alertes",
      "type": "link",
      "url": "/alerting/list",
      "icon": "bolt",
      "keepTime": false,
      "targetBlank": false,
      "tooltip": "Règles d'alerte (livrées sur Discord)"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Alerte de la sonde",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "#fab219",
        "expr": "{service=\"canary\"} | json | event=\"canary_alert_sent\"",
        "textFormat": "Alerte envoyée à la remédiation : {{target_service}} ({{type}})",
        "tagKeys": "",
        "titleFormat": "Alerte sonde"
      },
      {
        "name": "Remédiation lancée",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "#9085e9",
        "expr": "{service=\"remediation\"} | json | event=\"remediation_step\" | state=\"remediating\"",
        "textFormat": "{{message}}",
        "tagKeys": "",
        "titleFormat": "Remédiation"
      },
      {
        "name": "Reprise prouvée",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "#0ca30c",
        "expr": "{service=\"remediation\"} | json | event=\"remediation_step\" | state=\"resolved\"",
        "textFormat": "{{target_service}} : {{message}}",
        "tagKeys": "",
        "titleFormat": "Reprise prouvée"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Maintenant",
      "id": 1,
