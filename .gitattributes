# Les scripts exécutés dans les conteneurs Linux doivent rester en LF, même sous Windows (sinon : "bad interpreter")
*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.conf text eol=lf
*.py   text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
# Modèles nginx du WAF (montés dans un conteneur Linux) et lanceurs Windows
*.template text eol=lf
*.hcl text eol=lf

# Données et modèle ML : octets identiques sur tous les postes (empreinte sha256 enregistrée dans model.json)
*.jsonl  text eol=lf
*.joblib binary
